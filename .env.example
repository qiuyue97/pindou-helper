# 复制成 .env 再 docker compose up
#   Linux/NAS ssh:      echo "PINDOU_JWT_SECRET=$(openssl rand -hex 32)" > .env
#   Windows PowerShell: "PINDOU_JWT_SECRET=$([guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N'))" | Out-File -Encoding ascii .env

# 必填，≥32 字符。会话用它签名，改动会让所有人重新登录。
PINDOU_JWT_SECRET=

# 默认 1（https 部署）。只有临时用 http:// 直连调试时才改成 0，
# 否则浏览器会拒绝存 cookie，表现为每次请求都掉登录。
PINDOU_COOKIE_SECURE=1

# 只影响服务端日志时间；界面时间用浏览器本地时区。
TZ=Asia/Shanghai

# 宿主机映射端口。容器内固定 8000，这里只改宿主机侧。
PINDOU_PORT=8000

# --- 构建镜像源（默认国内，墙外构建时改成官方源）-------------------------
# REGISTRY=docker.io
# NPM_REGISTRY=https://registry.npmjs.org
# PIP_INDEX=https://pypi.org/simple
# APT_MIRROR=deb.debian.org
