# Copy to .env before `docker compose up`.
#   Linux/macOS/NAS ssh:  echo "PINDOU_JWT_SECRET=$(openssl rand -hex 32)" > .env
#   Windows PowerShell:   "PINDOU_JWT_SECRET=$([guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N'))" | Out-File -Encoding ascii .env

# Required. At least 32 characters — sessions are signed with it.
# Changing it invalidates every existing login.
PINDOU_JWT_SECRET=

# 0 for plain http:// on the LAN, 1 only when served over https://
PINDOU_COOKIE_SECURE=0

# Server log timestamps only; the UI uses the browser's timezone.
TZ=Asia/Shanghai
