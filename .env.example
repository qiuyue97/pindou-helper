# 复制成 .env 再 docker compose up
#   Linux/NAS ssh:      echo "PINDOU_JWT_SECRET=$(openssl rand -hex 32)" > .env
#   Windows PowerShell: "PINDOU_JWT_SECRET=$([guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N'))" | Out-File -Encoding ascii .env

# 必填，≥32 字符。会话用它签名，改动会让所有人重新登录。
PINDOU_JWT_SECRET=

# 默认 1（https 部署）。只有临时用 http:// 直连调试时才改成 0，
# 否则浏览器会拒绝存 cookie，表现为每次请求都掉登录。
PINDOU_COOKIE_SECURE=1

# 只影响服务端日志时间；界面时间用浏览器本地时区。
TZ=Asia/Shanghai

# 宿主机映射端口。容器内固定 8000，这里只改宿主机侧。
PINDOU_PORT=8000

# --- 构建镜像源（默认国内，墙外构建时改成官方源）-------------------------
# REGISTRY=docker.io
# NPM_REGISTRY=https://registry.npmjs.org
# PIP_INDEX=https://pypi.org/simple
# APT_MIRROR=deb.debian.org

# --- 智能管控（VIP 功能）用的 LLM 网关，OpenAI 兼容即可 ---
# 不配置的话，/api/smart/extract 会返回 503，其余功能不受影响。
PINDOU_LLM_BASE_URL=https://your-litellm-host
PINDOU_LLM_API_KEY=sk-xxxx
# 按顺序尝试，前一个失败自动退到下一个。留空则用代码里的默认清单。
PINDOU_LLM_MODELS=Kimi-K3-256K,GLM-5.2,dashscope/qwen3.8-max,gemini/gemma-4-31b-it,azure_ai/gpt-5.6-terra
PINDOU_LLM_TIMEOUT=60

# --- 拼豆图纸识别（VIP 功能）：FastGPT 上的插件 ---
# 不配置的话，/api/patterns 返回 503，其余功能不受影响。
PINDOU_FASTGPT_BASE_URL=https://your-fastgpt-host/api
PINDOU_FASTGPT_API_KEY=fastgpt-xxxx
PINDOU_FASTGPT_APP_ID=插件应用的 appId
# 按顺序尝试；工作流的 model_name 入参要接到 AI 节点的模型上，否则改了不生效。
PINDOU_FASTGPT_MODELS=kimi-k3,gpt-5.6-terra
# 识别在后台线程里跑，超时给足。
PINDOU_FASTGPT_TIMEOUT=1200
# 用户原图存放目录，必须落在持久卷上。
PINDOU_UPLOAD_DIR=/data/uploads
